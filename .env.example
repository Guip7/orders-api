APP_NAME=Orders API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# DB ENV
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_dev_password
POSTGRES_DB=orders
DATABASE_URL=postgresql+asyncpg://orders:orders_dev_password@localhost:5432/orders

# Gere uma chave nova com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-o-comando-acima
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7